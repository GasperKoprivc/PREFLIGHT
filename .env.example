# Copy these values into your shell/service environment. The server does not auto-load .env.
DATABASE_URL=sqlite://preflight.sqlite
PREFLIGHT_BIND=127.0.0.1:3001
PREFLIGHT_ROOM_TTL_SECONDS=86400
# Optional exact dashboard origin; omit for same-origin hosting.
# PREFLIGHT_ALLOWED_ORIGIN=https://preflight.example
