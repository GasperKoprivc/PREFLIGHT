{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Preflight",
  "version": "0.1.0",
  "identifier": "si.preflight.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Preflight",
        "width": 1080,
        "height": 780,
        "minWidth": 600,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Lokalno preverjanje razvojnega okolja pred delavnico",
    "longDescription": "Preflight izvaja lokalno diagnostiko in omogoča prostovoljno deljenje minimalnih rezultatov z učiteljem.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
