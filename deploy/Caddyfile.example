# Replace the hostname and dashboard directory before deployment.
preflight.example {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Content-Security-Policy "default-src 'self'; connect-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
    handle /api/* {
        request_body {
            max_size 96KB
        }
        reverse_proxy 127.0.0.1:3001
    }
    handle /health {
        reverse_proxy 127.0.0.1:3001
    }
    handle {
        root * /srv/preflight/dashboard
        try_files {path} /index.html
        file_server
    }
    # Access logging is intentionally not enabled here.
    # Add operator-approved abuse limits; see docs/deployment.md.
}
